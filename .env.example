# IoT Smart Agriculture Monitoring System
# Copy this file to .env and fill in your keys
# NEVER upload the actual .env file to GitHub

# ThingSpeak (optional - for cloud dashboard)
THINGSPEAK_API_KEY=your_thingspeak_write_api_key_here
THINGSPEAK_CHANNEL_ID=your_channel_id_here

# Blynk (optional - for mobile dashboard)
BLYNK_AUTH_TOKEN=your_blynk_auth_token_here

# MQTT Broker (optional - for IoT protocol)
MQTT_BROKER_HOST=broker.hivemq.com
MQTT_BROKER_PORT=1883
MQTT_TOPIC=smart_agriculture/sensors
